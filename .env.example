POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
INITIAL_USER_FIRST_NAME=
INITIAL_USER_LAST_NAME=
INITIAL_USER_LOGIN=
INITIAL_USER_PASSWORD=
WEB_PORT=3000
PGADMIN_PORT=5050
MARSTEK_DEVICES='[{"id":"venus-e3-1","name":"Venus E3","host":"192.168.3.224","port":30000}]'
FREELANCEHUNT_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Imported once as a Freelancehunt destination; manage channels in /settings/notifications.
# Low-battery recovery threshold is this value + 5%; allowed range 1..90.
MARSTEK_LOW_BATTERY_PERCENT=20
DOCKER_MONITORING_ENABLED=false
DOCKER_CONTROL_ENABLED=false
# Keep /dev/null when Docker monitoring is disabled. Set /var/run/docker.sock to enable it.
DOCKER_SOCKET_PATH=/dev/null
# Set the numeric group ID that owns Docker's socket when necessary.
DOCKER_SOCKET_GID=0
# Keep node normally. Some Docker Desktop sockets are writable only by the
# host user; use root only when the mounted socket returns EACCES for node.
DOCKER_WORKER_USER=node
# Set a 32+ character value only when Docker control is enabled.
# DOCKER_CONTROL_TOKEN=
