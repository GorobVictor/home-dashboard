{
  "name": "home-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @home-dashboard/web",
    "build": "npm run build --workspace @home-dashboard/web",
    "start": "npm run start --workspace @home-dashboard/web",
    "lint": "npm run lint --workspace @home-dashboard/web",
    "typecheck": "npm run typecheck --workspace @home-dashboard/web"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.8",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "prisma": "^8.0.0-rc.22",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
