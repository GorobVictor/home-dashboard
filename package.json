{
  "name": "home-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @home-dashboard/web",
    "dev:worker": "npm run dev --workspace @home-dashboard/worker",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @home-dashboard/web",
    "lint": "npm run lint --workspace @home-dashboard/web",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "node --import tsx scripts/test-e2e.mts",
    "test:ui": "E2E_UI_MATRIX=1 npm run test:e2e",
    "test": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/server/auth/*.test.ts apps/web/src/server/notifications.test.ts apps/web/src/server/marstek/*.test.ts packages/database/src/*.test.ts packages/integrations/src/*.test.ts apps/worker/src/jobs/*.test.ts",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:create-user": "node --import tsx apps/web/scripts/create-user.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
