generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  notifications Notification[]
  freelancehuntPreferences FreelancehuntPreferences?
  freelancehuntPresets FreelancehuntPreset[]
  freelancehuntProjects FreelancehuntProjectState[]
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  login        String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

enum EventSeverity {
  info
  warning
  error
  critical
}

enum NotificationStatus {
  pending
  processing
  sent
  failed
  cancelled
}

model Event {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source String @db.VarChar(64)
  type String @db.VarChar(100)
  severity EventSeverity
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  title String @db.VarChar(500)
  payload Json @default("{}") @db.JsonB
  deduplicationKey String? @unique @db.VarChar(255)
  notifications Notification[]

  @@index([occurredAt(sort: Desc), id])
  @@index([source, occurredAt(sort: Desc)])
  @@index([type, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@map("events")
}

// Durable observations are separate from the immutable event log.
model EventState {
  key String @id @db.VarChar(255)
  value String @db.VarChar(100)
  failures Int @default(0)
  lastEventAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("event_states")
}

model NotificationChannel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(100)
  kind String @default("telegram") @db.VarChar(16)
  chatId String @db.VarChar(100)
  enabled Boolean @default(true)
  minSeverity EventSeverity @default(info)
  sources Json @default("[]") @db.JsonB
  projectMinScore Int @default(0)
  projectScoring Json? @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  notifications Notification[]

  @@unique([kind, chatId])
  @@map("notification_channels")
}

model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recipientKey String @db.VarChar(100)
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String? @db.Uuid
  channel NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict)
  readAt DateTime? @db.Timestamptz(6)
  status NotificationStatus @default(pending)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(6)
  leaseUntil DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  deliveries NotificationDelivery[]

  @@unique([eventId, recipientKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

model NotificationDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String @db.Uuid
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  attempt Int
  status String @db.VarChar(20)
  destination String @db.VarChar(100)
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  errorCode String? @db.VarChar(100)
  externalMessageId String? @db.VarChar(100)

  @@unique([notificationId, attempt])
  @@index([startedAt(sort: Desc)])
  @@map("notification_deliveries")
}

model MarstekDevice {
  id          String               @id @db.VarChar(64)
  name        String               @db.VarChar(100)
  host        String               @db.VarChar(255)
  port        Int
  enabled     Boolean              @default(true)
  lastSeenAt  DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  lastError   String?              @map("last_error") @db.VarChar(100)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  measurements MarstekMeasurement[]

  @@map("marstek_devices")
}

model MarstekMeasurement {
  id                    BigInt        @id @default(autoincrement())
  deviceId              String        @map("device_id") @db.VarChar(64)
  device                MarstekDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sampledAt             DateTime      @map("sampled_at") @db.Timestamptz(6)
  socPercent            Float?        @map("soc_percent")
  batteryPowerW         Float?        @map("battery_power_w")
  powerSource           String        @map("power_source") @db.VarChar(16)
  chargePowerW          Float         @default(0) @map("charge_power_w")
  dischargePowerW       Float         @default(0) @map("discharge_power_w")
  chargeEnergyWh        Float         @default(0) @map("charge_energy_wh")
  dischargeEnergyWh     Float         @default(0) @map("discharge_energy_wh")
  flow                  String        @db.VarChar(16)
  gridPowerW            Float?        @map("grid_power_w")
  offgridPowerW         Float?        @map("offgrid_power_w")
  pvPowerW              Float?        @map("pv_power_w")
  batteryTemperatureC   Float?        @map("battery_temperature_c")
  remainingCapacityWh   Float?        @map("remaining_capacity_wh")
  ratedCapacityWh       Float?        @map("rated_capacity_wh")
  gridInputTotalWh      Float?        @map("grid_input_total_wh")
  gridOutputTotalWh     Float?        @map("grid_output_total_wh")
  pvTotalWh             Float?        @map("pv_total_wh")
  loadTotalWh           Float?        @map("load_total_wh")
  chargeAllowed         Boolean?      @map("charge_allowed")
  dischargeAllowed      Boolean?      @map("discharge_allowed")
  mode                  String?       @db.VarChar(32)
  ctConnected           Boolean?      @map("ct_connected")
  meterPowerW           Float?        @map("meter_power_w")

  @@index([deviceId, sampledAt(sort: Desc)])
  @@index([sampledAt])
  @@map("marstek_measurements")
}

model FreelancehuntSettings {
  id                       String   @id @default("default") @db.VarChar(32)
  enabled                  Boolean  @default(false)
  projectPollingEnabled    Boolean  @default(true) @map("project_polling_enabled")
  messagePollingEnabled    Boolean  @default(true) @map("message_polling_enabled")
  telegramEnabled          Boolean  @default(true) @map("telegram_enabled")
  pollIntervalSeconds      Int      @default(60) @map("poll_interval_seconds")
  skillIds                 Json     @default("[]") @map("skill_ids") @db.JsonB
  projectsInitialized      Boolean  @default(false) @map("projects_initialized")
  messagesInitialized      Boolean  @default(false) @map("messages_initialized")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("freelancehunt_settings")
}

model FreelancehuntProject {
  id          BigInt   @id @default(autoincrement())
  externalId  Int      @unique @map("external_id")
  name        String   @db.VarChar(500)
  description String?  @db.Text
  url         String   @db.VarChar(2048)
  budgetAmount Float?  @map("budget_amount")
  budgetCurrency String? @map("budget_currency") @db.VarChar(8)
  skills      Json     @default("[]") @db.JsonB
  skillIds    Json     @default("[]") @map("skill_ids") @db.JsonB
  categories  Json     @default("[]") @db.JsonB
  states      FreelancehuntProjectState[]
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  discoveredAt DateTime @default(now()) @map("discovered_at") @db.Timestamptz(6)

  @@index([discoveredAt(sort: Desc)])
  @@index([publishedAt(sort: Desc), externalId])
  @@index([budgetCurrency, budgetAmount])
  @@map("freelancehunt_projects")
}

model FreelancehuntPreferences {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters Json @db.JsonB
  scoring Json @db.JsonB
  notificationMinScore Int @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@map("freelancehunt_preferences")
}

model FreelancehuntPreset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String @db.VarChar(100)
  filters Json @db.JsonB
  scoring Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([userId, name])
  @@map("freelancehunt_presets")
}

model FreelancehuntProjectState {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId BigInt
  project FreelancehuntProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score Int
  reasons Json @db.JsonB
  savedAt DateTime? @db.Timestamptz(6)
  hiddenAt DateTime? @db.Timestamptz(6)
  viewedAt DateTime? @db.Timestamptz(6)
  notes String @default("") @db.Text
  @@id([userId, projectId])
  @@index([userId, score(sort: Desc), projectId])
  @@index([userId, savedAt])
  @@index([userId, hiddenAt])
  @@index([userId, viewedAt])
  @@map("freelancehunt_project_states")
}

model FreelancehuntThread {
  id            BigInt   @id @default(autoincrement())
  externalId    Int      @unique @map("external_id")
  subject       String   @db.VarChar(500)
  url           String   @db.VarChar(2048)
  lastPostedAt  DateTime? @map("last_posted_at") @db.Timestamptz(6)
  messagesCount Int      @default(0) @map("messages_count")
  isUnread      Boolean  @default(false) @map("is_unread")
  discoveredAt  DateTime @default(now()) @map("discovered_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isUnread, lastPostedAt(sort: Desc)])
  @@map("freelancehunt_threads")
}
